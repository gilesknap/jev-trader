# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
**/_version.py

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
cov.xml
.pytest_cache/
.mypy_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/
docs/_api

# PyBuilder
target/

# likely venv names
.venv*
venv*

# further build artifacts
lockfiles/

# ruff cache
.ruff_cache/

# This project
runtime/
.env
.last_run
.last_postclose
strategist-alerts.log
replays/
# Decision logs stay on disk (90 days) for the strategist, but out of git history (disk budget).
logs/decisions/*.jsonl.gz
docs/_generated/
# Deploy files rendered from an owner's config.yaml belong in that owner's data repo, never here.
# By exact name: deploy/systemd/trader-watchdog.timer is a static unit the code ships.
deploy/systemd/trader-runner.timer
deploy/systemd/trader.env
deploy/systemd-trader/*.timer
