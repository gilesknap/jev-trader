[Unit]
Description=Trader dashboard (private Unix socket; exposed only via tailscale serve)

[Service]
EnvironmentFile=%h/.config/trading/services.env
WorkingDirectory=/srv/trading/main
UMask=0027
ExecStartPre=/bin/rm -f %t/trader-dashboard.sock
ExecStart=/usr/local/bin/uv run --frozen trader dashboard --uds %t/trader-dashboard.sock
Restart=always

[Install]
WantedBy=default.target
