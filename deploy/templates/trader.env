# Environment for the runner user's trader services (installed to ~/.config/trading/services.env).
# TEMPLATE: double-brace keys come from config.yaml. Edit here, then run `uv run trader config render-deploy`.
TRADER_CODE_ROOT=/srv/trading/main
TRADER_STRATEGIST_ROOT=/srv/trading/strategist
TRADER_RUNTIME=/srv/trading/runtime
TRADER_REPLAY_DIR=/srv/trading/strategist/replays
TRADER_SECRETS=/home/runner/.config/trading/env
TRADER_STRATEGIST_STAMP=/srv/trading/strategist/.last_run
TRADER_DASHBOARD_USERS={{ dashboard.users }}
