# TEMPLATE: double-brace keys come from config.yaml. Edit here, then run `uv run trader config render-deploy`.
[Unit]
Description=Start the trader runner before the US open (runner checks the calendar itself)

[Timer]
OnCalendar=Mon..Fri {{ schedule.runner_start }} {{ schedule.local_tz }}
Persistent=true

[Install]
WantedBy=timers.target
