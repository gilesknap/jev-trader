# GENERATED from deploy/templates/trader-strategist.timer and config.yaml by `trader config render-deploy`: edit those, not this file.
[Unit]
Description=Strategist postclose run (the script self-gates on the market clock and runs once a day)

[Timer]
OnCalendar=Mon..Fri 21,22:30 Europe/London
Unit=trader-strategist@postclose.service

[Install]
WantedBy=timers.target
