# GENERATED from deploy/templates/trader-strategist.timer and config.yaml by `trader config render-deploy`: edit those, not this file.
[Unit]
Description=Strategist housekeeping run (the script self-gates on the market clock and runs once a day)

[Timer]
OnCalendar=*-*-* 09:00 Europe/London
Unit=trader-strategist@housekeeping.service

[Install]
WantedBy=timers.target
