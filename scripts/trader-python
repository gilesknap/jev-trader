#!/bin/sh
# trader's venv python with the same environment as `trader` (scripts/trader-shim), for the
# charter's ad-hoc research (fetch_alpaca, NewsClient) in the split layout (#169 section 6.2).
# Installed as ~trader/.local/bin/trader-python by 2-strategist.sh.
export TRADER_CODE_ROOT=/srv/trading/main TRADER_DATA_ROOT=/srv/trading/config \
       TRADER_STRATEGIST_ROOT=/srv/trading/strategist TRADER_RUNTIME=/srv/trading/runtime \
       TRADER_REPLAY_DIR=/srv/trading/strategist/replays TRADER_SECRETS=/srv/trading/strategist/.env
exec "$HOME/.local/share/trader/venv/bin/python" "$@"
